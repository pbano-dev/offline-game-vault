{
  "$defs": {
    "digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "embeddedArtifact": {
      "additionalProperties": false,
      "properties": {
        "container_object": {
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "id": {
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "type": "string"
        },
        "license_note": {
          "type": "string"
        },
        "roles": {
          "items": {
            "enum": [
              "original",
              "derived",
              "configuration",
              "save",
              "tool",
              "media",
              "documentation",
              "other"
            ]
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "size": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "digest",
        "roles",
        "container_object"
      ],
      "type": "object"
    },
    "object": {
      "additionalProperties": false,
      "properties": {
        "archive_path": {
          "$ref": "#/$defs/relativePath"
        },
        "description": {
          "type": "string"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "format": {
          "enum": [
            "file",
            "directory",
            "tar",
            "tar.gz",
            "tar.zst",
            "zip",
            "flatpak_repo",
            "other"
          ]
        },
        "id": {
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "type": "string"
        },
        "kind": {
          "description": "Primary human-facing classification. It does not affect the content-addressed object path.",
          "enum": [
            "game-payload",
            "runner",
            "runtime",
            "backend",
            "tool",
            "cache",
            "host-dependency",
            "documentation",
            "state-seed",
            "historical",
            "other"
          ]
        },
        "license_note": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "roles": {
          "items": {
            "enum": [
              "game_payload",
              "original",
              "derived",
              "prefix_baseline",
              "save",
              "configuration",
              "runner",
              "runtime",
              "tool",
              "media",
              "documentation",
              "other"
            ]
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "scope": {
          "description": "Declared reuse scope. It is metadata and does not alter object identity.",
          "enum": [
            "shared",
            "game-specific",
            "historical"
          ]
        },
        "shared": {
          "default": false,
          "type": "boolean"
        },
        "size": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "digest",
        "roles",
        "format",
        "required"
      ],
      "type": "object"
    },
    "playable": {
      "additionalProperties": false,
      "properties": {
        "backend": {
          "const": "wine"
        },
        "layout": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "destination": {
                "$ref": "#/$defs/relativePath"
              },
              "object": {
                "minLength": 1,
                "type": "string"
              },
              "source": {
                "$ref": "#/$defs/relativePath"
              }
            },
            "required": [
              "object",
              "source",
              "destination"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        },
        "paths": {
          "additionalProperties": false,
          "properties": {
            "launcher": {
              "$ref": "#/$defs/relativePath"
            },
            "prefix": {
              "$ref": "#/$defs/relativePath"
            },
            "runner": {
              "$ref": "#/$defs/relativePath"
            },
            "runtime": {
              "$ref": "#/$defs/relativePath"
            },
            "uninstaller": {
              "$ref": "#/$defs/relativePath"
            },
            "wine": {
              "$ref": "#/$defs/relativePath"
            },
            "wineserver": {
              "$ref": "#/$defs/relativePath"
            }
          },
          "required": [
            "prefix",
            "runner",
            "wine",
            "wineserver",
            "runtime",
            "launcher",
            "uninstaller"
          ],
          "type": "object"
        },
        "prefix_operations": {
          "items": {
            "oneOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "path": {
                    "$ref": "#/$defs/relativePath"
                  },
                  "type": {
                    "const": "mkdir"
                  }
                },
                "required": [
                  "type",
                  "path"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "path": {
                    "$ref": "#/$defs/relativePath"
                  },
                  "target": {
                    "minLength": 1,
                    "not": {
                      "pattern": "^(?:/|[A-Za-z]:[\\\\/])"
                    },
                    "type": "string"
                  },
                  "type": {
                    "const": "symlink"
                  }
                },
                "required": [
                  "type",
                  "path",
                  "target"
                ],
                "type": "object"
              }
            ]
          },
          "type": "array"
        },
        "protected_files": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "digest": {
                "$ref": "#/$defs/digest"
              },
              "path": {
                "$ref": "#/$defs/relativePath"
              },
              "size": {
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "path",
              "digest"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        },
        "schema": {
          "const": 0
        }
      },
      "required": [
        "schema",
        "backend",
        "paths",
        "layout",
        "protected_files"
      ],
      "type": "object"
    },
    "profile": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "adapter": {
                "const": "umu"
              }
            },
            "required": [
              "adapter"
            ]
          },
          "then": {
            "required": [
              "umu"
            ]
          }
        }
      ],
      "properties": {
        "adapter": {
          "enum": [
            "bottles",
            "wine",
            "umu",
            "windows",
            "vm",
            "other"
          ]
        },
        "dependencies": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "host_contract": {
          "$ref": "#/$defs/relativePath"
        },
        "id": {
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "type": "string"
        },
        "launch": {
          "additionalProperties": false,
          "properties": {
            "arguments": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "entrypoint": {
              "$ref": "#/$defs/relativePath"
            },
            "environment": {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            "network": {
              "enum": [
                "isolated",
                "allowed",
                "host_default"
              ]
            },
            "working_directory": {
              "$ref": "#/$defs/relativePath"
            }
          },
          "required": [
            "entrypoint"
          ],
          "type": "object"
        },
        "notes": {
          "type": "string"
        },
        "platform": {
          "enum": [
            "linux",
            "windows"
          ]
        },
        "playable": {
          "$ref": "#/$defs/playable"
        },
        "umu": {
          "$ref": "#/$defs/umuPlayable"
        }
      },
      "required": [
        "id",
        "platform",
        "adapter",
        "dependencies",
        "host_contract",
        "launch"
      ],
      "type": "object"
    },
    "relativePath": {
      "minLength": 1,
      "not": {
        "pattern": "^(?:/|[A-Za-z]:[\\\\/])"
      },
      "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$)).+$",
      "type": "string"
    },
    "stateItem": {
      "additionalProperties": false,
      "properties": {
        "backup": {
          "default": true,
          "type": "boolean"
        },
        "description": {
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "type": "string"
        },
        "kind": {
          "enum": [
            "save",
            "identity",
            "configuration",
            "cache",
            "log",
            "temporary",
            "other"
          ]
        },
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "required": {
          "default": true,
          "type": "boolean"
        },
        "sensitive": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "path",
        "kind"
      ],
      "type": "object"
    },
    "umuPlayable": {
      "additionalProperties": false,
      "properties": {
        "allowed_absolute_symlinks": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "path": {
                "$ref": "#/$defs/relativePath"
              },
              "target": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "path",
              "target"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "hardlink_manifests": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "root": {
                "$ref": "#/$defs/relativePath"
              },
              "source": {
                "$ref": "#/$defs/relativePath"
              }
            },
            "required": [
              "source",
              "root"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "launchers": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "destination": {
                "$ref": "#/$defs/relativePath"
              },
              "digest": {
                "$ref": "#/$defs/digest"
              },
              "mode": {
                "maximum": 511,
                "minimum": 0,
                "type": "integer"
              },
              "source": {
                "$ref": "#/$defs/relativePath"
              }
            },
            "required": [
              "source",
              "destination",
              "digest",
              "mode"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        },
        "layout": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "archive_policy": {
                "additionalProperties": false,
                "properties": {
                  "allow_absolute_symlinks": {
                    "default": false,
                    "type": "boolean"
                  },
                  "allow_hardlinks": {
                    "default": false,
                    "type": "boolean"
                  }
                },
                "type": "object"
              },
              "destination": {
                "$ref": "#/$defs/relativePath"
              },
              "object": {
                "minLength": 1,
                "type": "string"
              },
              "source": {
                "$ref": "#/$defs/relativePath"
              }
            },
            "required": [
              "object",
              "source",
              "destination"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        },
        "mutable_paths": {
          "items": {
            "$ref": "#/$defs/relativePath"
          },
          "type": "array",
          "uniqueItems": true
        },
        "nested_archives": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "destination": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/relativePath"
                  },
                  {
                    "const": "."
                  }
                ]
              },
              "digest": {
                "$ref": "#/$defs/digest"
              },
              "path": {
                "$ref": "#/$defs/relativePath"
              },
              "remove_after": {
                "type": "boolean"
              }
            },
            "required": [
              "path",
              "digest"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "offline_environment": {
          "additionalProperties": false,
          "properties": {
            "cache_entries": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
                    "type": "string"
                  },
                  "path": {
                    "$ref": "#/$defs/relativePath"
                  },
                  "required_files": {
                    "items": {
                      "additionalProperties": false,
                      "properties": {
                        "digest": {
                          "$ref": "#/$defs/digest"
                        },
                        "path": {
                          "$ref": "#/$defs/relativePath"
                        },
                        "size": {
                          "minimum": 0,
                          "type": "integer"
                        }
                      },
                      "required": [
                        "path",
                        "digest",
                        "size"
                      ],
                      "type": "object"
                    },
                    "type": "array"
                  }
                },
                "required": [
                  "id",
                  "path",
                  "required_files"
                ],
                "type": "object"
              },
              "type": "array"
            },
            "runtime": {
              "additionalProperties": false,
              "properties": {
                "family": {
                  "minLength": 1,
                  "type": "string"
                },
                "path": {
                  "$ref": "#/$defs/relativePath"
                },
                "required_paths": {
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "path": {
                        "$ref": "#/$defs/relativePath"
                      },
                      "type": {
                        "enum": [
                          "directory",
                          "file"
                        ]
                      }
                    },
                    "required": [
                      "path",
                      "type"
                    ],
                    "type": "object"
                  },
                  "minItems": 1,
                  "type": "array"
                },
                "version": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "family",
                "version",
                "path",
                "required_paths"
              ],
              "type": "object"
            },
            "runtime_update": {
              "const": false
            },
            "xdg_cache_home": {
              "$ref": "#/$defs/relativePath"
            },
            "xdg_data_home": {
              "$ref": "#/$defs/relativePath"
            }
          },
          "required": [
            "xdg_data_home",
            "xdg_cache_home",
            "runtime_update",
            "runtime",
            "cache_entries"
          ],
          "type": "object"
        },
        "paths": {
          "additionalProperties": false,
          "properties": {
            "launcher": {
              "$ref": "#/$defs/relativePath"
            },
            "runtime_var": {
              "$ref": "#/$defs/relativePath"
            },
            "sanitizer": {
              "$ref": "#/$defs/relativePath"
            }
          },
          "required": [
            "launcher",
            "sanitizer",
            "runtime_var"
          ],
          "type": "object"
        },
        "protected_manifests": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "source": {
                "$ref": "#/$defs/relativePath"
              },
              "when_save": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "source"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "schema": {
          "const": 0
        },
        "state_archives": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "digest": {
                "$ref": "#/$defs/digest"
              },
              "filename": {
                "$ref": "#/$defs/relativePath"
              },
              "id": {
                "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
                "type": "string"
              },
              "policy": {
                "enum": [
                  "always",
                  "selectable"
                ]
              }
            },
            "required": [
              "id",
              "filename",
              "digest",
              "policy"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "symlink_manifests": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "allow_unresolved": {
                "default": false,
                "type": "boolean"
              },
              "prefixes": {
                "items": {
                  "$ref": "#/$defs/relativePath"
                },
                "minItems": 1,
                "type": "array",
                "uniqueItems": true
              },
              "source": {
                "$ref": "#/$defs/relativePath"
              }
            },
            "required": [
              "source",
              "prefixes"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "schema",
        "layout",
        "launchers",
        "protected_manifests",
        "symlink_manifests",
        "paths"
      ],
      "type": "object"
    }
  },
  "$id": "https://offline-game-vault.invalid/schemas/capsule.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "capsule_id": {
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
      "type": "string"
    },
    "documents": {
      "additionalProperties": false,
      "properties": {
        "credits": {
          "$ref": "#/$defs/relativePath"
        },
        "game_sheet": {
          "$ref": "#/$defs/relativePath"
        },
        "preserved_by": {
          "$ref": "#/$defs/relativePath"
        },
        "readme": {
          "$ref": "#/$defs/relativePath"
        }
      },
      "required": [
        "readme",
        "game_sheet",
        "credits",
        "preserved_by"
      ],
      "type": "object"
    },
    "embedded_artifacts": {
      "items": {
        "$ref": "#/$defs/embeddedArtifact"
      },
      "type": "array"
    },
    "game": {
      "additionalProperties": false,
      "properties": {
        "appid": {
          "type": [
            "integer",
            "string"
          ]
        },
        "edition": {
          "type": "string"
        },
        "language": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "preserved_version": {
          "minLength": 1,
          "type": "string"
        },
        "source_store": {
          "minLength": 1,
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "title",
        "source_store",
        "preserved_version"
      ],
      "type": "object"
    },
    "objects": {
      "description": "First-class objects only: one canonical game object plus shared runner/runtime archives. Internal critical files belong in embedded_artifacts.",
      "items": {
        "$ref": "#/$defs/object"
      },
      "minItems": 1,
      "type": "array"
    },
    "persistent_state": {
      "items": {
        "$ref": "#/$defs/stateItem"
      },
      "type": "array"
    },
    "privacy_exceptions": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "minLength": 1,
            "type": "string"
          },
          "reason": {
            "minLength": 1,
            "type": "string"
          },
          "scope": {
            "items": {
              "$ref": "#/$defs/relativePath"
            },
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "id",
          "reason",
          "scope"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "profiles": {
      "items": {
        "$ref": "#/$defs/profile"
      },
      "minItems": 1,
      "type": "array"
    },
    "regenerable_state": {
      "items": {
        "$ref": "#/$defs/stateItem"
      },
      "type": "array"
    },
    "sanitized_fixture": {
      "default": false,
      "type": "boolean"
    },
    "schema": {
      "const": 0
    }
  },
  "required": [
    "schema",
    "capsule_id",
    "game",
    "documents",
    "objects",
    "profiles"
  ],
  "title": "Offline Game Vault capsule",
  "type": "object"
}
